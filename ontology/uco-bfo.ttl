# imports: http://purl.obolibrary.org/obo/bfo/2020/bfo-core.ttl
# imports: https://ontology.unifiedcyberontology.org/uco/uco/1.5.0

@prefix drafting: <http://example.org/ontology/drafting/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/uco/action/> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core/> .
@prefix uco-identity: <https://ontology.unifiedcyberontology.org/uco/identity/> .
@prefix uco-location: <https://ontology.unifiedcyberontology.org/uco/location/> .
@prefix uco-observable: <https://ontology.unifiedcyberontology.org/uco/observable/> .
@prefix uco-pattern: <https://ontology.unifiedcyberontology.org/uco/pattern/> .
@prefix uco-role: <https://ontology.unifiedcyberontology.org/uco/role/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/ontology/uco-bfo>
	a owl:Ontology ;
	owl:imports
		<http://purl.obolibrary.org/obo/bfo/2020/bfo-core.ttl> ,
		<https://ontology.unifiedcyberontology.org/uco/uco/1.5.0>
		;
	.

drafting:Capability
	a owl:Class ;
	rdfs:subClassOf
		drafting:Endurant ,
		uco-core:UcoInherentCharacterizationThing
		;
	rdfs:comment "Beverly et al. 2024 (ontocom-2.pdf), Section 4's paragraph prior to 4.1, makes specific remarks on 'capabilities' of software being a shorthand for a capability of a physical thing that can execute the software; also, on software being a Generically Dependent Continuant, which in BFO does not bear Dispositions.  Hence, Capability within UCO, being often concerned with software (see SoftwareCapability), aligns as a superclass, rather than a subclass, of the Capability class proposed by Beverly et al.  SpecificCapability is defined to satisfy the design of Beverly et al."@en ;
	rdfs:isDefinedBy
		<https://ceur-ws.org/Vol-3882/ontocom-2.pdf> ,
		<https://github.com/ucoProject/UCO/issues/682>
		;
	rdfs:seeAlso drafting:SoftwareCapability ;
	owl:disjointUnionOf (
		drafting:GenericCapability
		drafting:SpecificCapability
	) ;
	.

drafting:Endurant
	a owl:Class ;
	rdfs:subClassOf
		obo:BFO_0000002 ,
		uco-core:UcoThing
		;
	rdfs:isDefinedBy <https://github.com/ucoProject/UCO/issues/544> ;
	owl:disjointWith drafting:Perdurant ;
	.

drafting:GenericCapability
	a owl:Class ;
	rdfs:subClassOf
		drafting:Capability ,
		obo:BFO_0000031 ,
		[
			a owl:Restriction ;
			owl:onProperty obo:BFO_0000058 ;
			owl:allValuesFrom drafting:SpecificCapability ;
		]
		;
	rdfs:comment '"Generic Capability" is named for "Generically Dependent Continuant", BFO_0000031.  The relation between "generic" and "specific" in this BFO context is not a superclass/subclass relationship.'@en ;
	rdfs:isDefinedBy <https://github.com/ucoProject/UCO/issues/682> ;
	rdfs:seeAlso <https://ceur-ws.org/Vol-3882/ontocom-2.pdf> ;
	owl:disjointWith drafting:SpecificCapability ;
	.

drafting:Instant
	a owl:Class ;
	rdfs:subClassOf
		drafting:InstantaneousPerdurant ,
		obo:BFO_0000203
		;
	.

drafting:InstantaneousPerdurant
	a owl:Class ;
	rdfs:subClassOf drafting:Perdurant ;
	rdfs:isDefinedBy <https://github.com/ucoProject/UCO/issues/651> ;
	.

drafting:Perdurant
	a owl:Class ;
	rdfs:subClassOf
		obo:BFO_0000003 ,
		uco-core:UcoObject
		;
	rdfs:isDefinedBy
		<https://github.com/ucoProject/UCO/issues/544> ,
		<https://github.com/ucoProject/UCO/issues/651>
		;
	owl:disjointWith drafting:Endurant ;
	.

drafting:Quality
	a owl:Class ;
	rdfs:subClassOf
		drafting:Endurant ,
		obo:BFO_0000019 ,
		uco-core:UcoInherentCharacterizationThing
		;
	owl:disjointWith uco-core:Facet ;
	.

drafting:SoftwareCapability
	a owl:Class ;
	rdfs:subClassOf
		drafting:GenericCapability ,
		[
			a owl:Restriction ;
			owl:onProperty obo:BFO_0000084 ;
			owl:someValuesFrom uco-observable:Computer ;
		]
		;
	rdfs:isDefinedBy <https://github.com/ucoProject/UCO/issues/682> ;
	rdfs:seeAlso <https://ceur-ws.org/Vol-3882/ontocom-2.pdf> ;
	.

drafting:SpecificCapability
	a owl:Class ;
	rdfs:subClassOf
		drafting:Capability ,
		obo:BFO_0000016
		;
	rdfs:isDefinedBy <https://github.com/ucoProject/UCO/issues/682> ;
	rdfs:seeAlso <https://ceur-ws.org/Vol-3882/ontocom-2.pdf> ;
	owl:disjointWith drafting:GenericCapability ;
	.

obo:BFO_0000002
	rdfs:label "continuant"@en ;
	.

obo:BFO_0000003
	rdfs:label "occurrent"@en ;
	.

obo:BFO_0000004
	rdfs:label "independent continuant"@en ;
	.

obo:BFO_0000006
	rdfs:label "spatial region"@en ;
	.

obo:BFO_0000008
	rdfs:label "temporal region"@en ;
	.

obo:BFO_0000015
	rdfs:label "process"@en ;
	.

obo:BFO_0000016
	rdfs:label "disposition"@en ;
	.

obo:BFO_0000019
	rdfs:label "quality"@en ;
	.

obo:BFO_0000020
	rdfs:label "specifically dependent continuant"@en ;
	.

obo:BFO_0000031
	rdfs:label "generically dependent continuant"@en ;
	.

obo:BFO_0000034
	rdfs:subClassOf drafting:SpecificCapability ;
	rdfs:label "function"@en ;
	rdfs:comment "Beverly et al. 2024 (ontocom-2.pdf) propose Capability as a subclass of Disposition, but superclass of Function."@en ;
	rdfs:seeAlso <https://ceur-ws.org/Vol-3882/ontocom-2.pdf> ;
	.

obo:BFO_0000040
	rdfs:label "material entity"@en ;
	.

obo:BFO_0000058
	rdfs:label "is concretized by"@en ;
	.

obo:BFO_0000084
	rdfs:label "generically depends on"@en ;
	.

obo:BFO_0000196
	rdfs:label "bearer of"@en ;
	.

obo:BFO_0000203
	rdfs:label "temporal instant"@en ;
	.

uco-action:Action
	rdfs:subClassOf
		drafting:Perdurant ,
		obo:BFO_0000015
		;
	.

uco-core:Event
	rdfs:subClassOf
		drafting:Perdurant ,
		obo:BFO_0000008
		;
	.

uco-core:Facet
	rdfs:subClassOf obo:BFO_0000020 ;
	owl:disjointWith drafting:Quality ;
	.

uco-core:Item
	rdfs:subClassOf drafting:Endurant ;
	.

uco-core:hasFacet
	rdfs:subPropertyOf obo:BFO_0000196 ;
	.

uco-identity:Identity
	rdfs:subClassOf drafting:Endurant ;
	.

uco-identity:Person
	rdfs:subClassOf obo:BFO_0000040 ;
	.

uco-location:Location
	rdfs:subClassOf
		drafting:Endurant ,
		obo:BFO_0000006
		;
	.

uco-observable:ContentData
	rdfs:subClassOf obo:BFO_0000004 ;
	.

uco-observable:Device
	rdfs:subClassOf obo:BFO_0000040 ;
	.

uco-observable:File
	rdfs:subClassOf obo:BFO_0000031 ;
	.

uco-observable:ObservablePattern
	rdfs:subClassOf drafting:Endurant ;
	.

uco-pattern:LogicalPattern
	rdfs:subClassOf drafting:Endurant ;
	.

[]
	a owl:Axiom ;
	rdfs:comment "Note that BFO 196 ('bearer of') has a domain restriction, that the subject not be a spatial region.  This could cause conflicts with UCO's Location namespace: If uco-location:Location or some subclass are believed to be specializations of BFO 6 ('spatial region'), then with this alignment of BFO 196, they cannot have a Facet."@en ;
	owl:annotatedObject obo:BFO_0000196 ;
	owl:annotatedProperty rdfs:subPropertyOf ;
	owl:annotatedSubject uco-core:hasFacet ;
	.

[]
	a owl:Axiom ;
	rdfs:comment "Per Facet appearing to be aligned with a subclass of Specifically Dependent Continuant that is neither a Quality, nor necessarily a Realizable Entity."@en ;
	owl:annotatedProperty owl:disjointWith ;
	owl:annotatedSource uco-core:Facet ;
	owl:annotatedTarget drafting:Quality ;
	.

[]
	a owl:Axiom ;
	rdfs:comment "Per an example of usage from BFO 2.0, 'the pdf file on your laptop, the pdf file that is a copy thereof on my laptop'."@en ;
	owl:annotatedProperty rdfs:subClassOf ;
	owl:annotatedSource uco-observable:File ;
	owl:annotatedTarget obo:BFO_0000031 ;
	.

[]
	a owl:Axiom ;
	rdfs:comment "Per usage with a Quality that presents a ContentData object's ability to be measured with the result being a Hash.  This usage with BFO_0000080 requires the quality-bearer be an independent continuant, but does not require a more specific subclass."@en ;
	owl:annotatedProperty rdfs:subClassOf ;
	owl:annotatedSource uco-observable:ContentData ;
	owl:annotatedTarget obo:BFO_0000004 ;
	.

